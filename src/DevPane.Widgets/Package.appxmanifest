<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 com rescap">

  <!-- Development identity. The Microsoft Store replaces Name and Publisher at release. -->
  <Identity Name="DevPane" Publisher="CN=DevPane Dev" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Dev Pane</DisplayName>
    <PublisherDisplayName>Dev Pane</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <!-- No Start menu entry yet: the provider has no window until the Dev Pane app exists (M2). -->
      <uap:VisualElements
        DisplayName="Dev Pane"
        Description="Developer cards for the Windows 11 Widgets Board"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- "devpane" on the command line, used as Claude Code's status line to report live plan limits. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="devpane.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!-- The process Windows launches when the Widgets Board needs Dev Pane cards. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="DevPane.Widgets.exe" DisplayName="Dev Pane widget provider">
              <com:Class Id="0486BD7C-EC81-47F7-80BB-289792540301" DisplayName="Dev Pane widget provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Registers Dev Pane with the Widgets Board. Each Definition is one card in the + dialog. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Dev Pane" Id="DevPaneWidgets" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="0486BD7C-EC81-47F7-80BB-289792540301" />
                </Activation>
                <Definitions>
                  <Definition
                    Id="SystemStats"
                    DisplayName="System stats"
                    Description="CPU, memory, GPU, disk and network"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\SystemStats_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\SystemStats_Screenshot.png" DisplayAltText="System stats card showing CPU, RAM and GPU usage" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                  <Definition
                    Id="LocalDev"
                    DisplayName="Local dev"
                    Description="Dev servers on your ports, dev tool memory, and WSL/Docker memory"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\LocalDev_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\LocalDev_Screenshot.png" DisplayAltText="Local dev card listing dev servers and their ports" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                  <!-- AllowMultiple and IsCustomizable: pin one card for all repositories and more for single repositories. -->
                  <Definition
                    Id="GitHub"
                    DisplayName="GitHub"
                    Description="Pull requests waiting for you, your CI status, assigned issues, and workflow runs"
                    AllowMultiple="true"
                    IsCustomizable="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <!-- The official GitHub mark, unmodified: white on dark themes, black on light themes. -->
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\GitHub_Icon_Light.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\GitHub_Screenshot.png" DisplayAltText="GitHub card with review requests and pull request status" />
                      </Screenshots>
                      <DarkMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\GitHub_Icon_Dark.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\GitHub_Screenshot.png" DisplayAltText="GitHub card with review requests and pull request status" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\GitHub_Icon_Light.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\GitHub_Screenshot.png" DisplayAltText="GitHub card with review requests and pull request status" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                  <Definition
                    Id="GitHubContributions"
                    DisplayName="GitHub contributions"
                    Description="Your contribution calendar and streaks"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\GitHub_Icon_Light.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\GitHubContributions_Screenshot.png" DisplayAltText="Contribution calendar with current and longest streak" />
                      </Screenshots>
                      <DarkMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\GitHub_Icon_Dark.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\GitHubContributions_Screenshot.png" DisplayAltText="Contribution calendar with current and longest streak" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\GitHub_Icon_Light.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\GitHubContributions_Screenshot.png" DisplayAltText="Contribution calendar with current and longest streak" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                  <Definition
                    Id="ClaudeUsage"
                    DisplayName="Claude Code usage"
                    Description="Claude Code usage on this PC: your current session and week with reset times, and the last 7 days"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\ClaudeUsage_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\ClaudeUsage_Screenshot.png" DisplayAltText="Claude Code usage card with the current session, this week, and a 7-day chart" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                  <!-- AllowMultiple and IsCustomizable: pin one card for everything and more for single teams or projects. -->
                  <Definition
                    Id="Vercel"
                    DisplayName="Vercel"
                    Description="Your latest Vercel deployments and production status per project"
                    AllowMultiple="true"
                    IsCustomizable="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\Vercel_Icon_Light.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\Vercel_Screenshot.png" DisplayAltText="Vercel card listing recent deployments with their status" />
                      </Screenshots>
                      <DarkMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\Vercel_Icon_Dark.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\Vercel_Screenshot.png" DisplayAltText="Vercel card listing recent deployments with their status" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Icons>
                          <Icon Path="Assets\Widgets\Vercel_Icon_Light.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\Vercel_Screenshot.png" DisplayAltText="Vercel card listing recent deployments with their status" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                  <!-- AllowMultiple and IsCustomizable: pin one card per view or project. -->
                  <Definition
                    Id="Jira"
                    DisplayName="Jira"
                    Description="Your Jira issues: assigned to you, the current sprint, reported, or watched"
                    AllowMultiple="true"
                    IsCustomizable="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widgets\Jira_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\Jira_Screenshot.png" DisplayAltText="Jira card with issue counts by status and your open issues" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
