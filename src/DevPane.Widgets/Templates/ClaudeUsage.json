{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$when": "${size != 'small'}",
      "minHeight": "14px",
      "items": []
    },
    {
      "type": "TextBlock",
      "$when": "${state == 'loading'}",
      "text": "Reading Claude Code logs…",
      "size": "small",
      "isSubtle": true
    },
    {
      "type": "Container",
      "$when": "${state == 'missing'}",
      "items": [
        { "type": "TextBlock", "text": "No Claude Code usage yet", "weight": "bolder", "wrap": true, "maxLines": 2 },
        { "type": "TextBlock", "text": "Use Claude Code on this PC, and your session and weekly usage show up here.", "size": "small", "isSubtle": true, "wrap": true, "maxLines": 3, "spacing": "small" }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'ready'}",
      "items": [
        {
          "type": "ColumnSet",
          "$when": "${size != 'large'}",
          "columns": [
            {
              "type": "Column",
              "$data": "${limits}",
              "width": "stretch",
              "spacing": "large",
              "items": [
                { "type": "TextBlock", "text": "${title}", "size": "small", "isSubtle": true, "maxLines": 1 },
                { "type": "TextBlock", "text": "${bigValue}", "size": "extraLarge", "weight": "bolder", "color": "${valueColor}", "spacing": "none", "maxLines": 1 },
                { "type": "Image", "$when": "${hasBar}", "url": "${bar}", "size": "stretch", "spacing": "small", "altText": "${value}" },
                { "type": "TextBlock", "text": "${shortCaption}", "size": "small", "isSubtle": true, "spacing": "small", "maxLines": 1 }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$when": "${size == 'large'}",
          "items": [
            {
              "type": "Container",
              "$data": "${limits}",
              "spacing": "${spacing}",
              "items": [
                {
                  "type": "ColumnSet",
                  "columns": [
                    { "type": "Column", "width": "stretch", "verticalContentAlignment": "center", "items": [ { "type": "TextBlock", "text": "${title}", "weight": "bolder", "maxLines": 1 } ] },
                    { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "items": [ { "type": "TextBlock", "text": "${value}", "size": "small", "weight": "bolder", "color": "${valueColor}" } ] }
                  ]
                },
                { "type": "Image", "$when": "${hasBar}", "url": "${bar}", "size": "stretch", "spacing": "small", "altText": "${value}" },
                { "type": "TextBlock", "text": "${caption}", "size": "small", "isSubtle": true, "spacing": "small", "maxLines": 1 }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$when": "${size != 'small'}",
          "spacing": "${gap}",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${chartTitle}", "size": "small", "weight": "bolder", "maxLines": 1 } ] },
                { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${chartTotal}", "size": "small", "weight": "bolder", "isSubtle": true } ] }
              ]
            },
            { "type": "Image", "url": "${chart}", "size": "stretch", "spacing": "default", "altText": "Usage over the last 7 days" },
            {
              "type": "ColumnSet",
              "spacing": "small",
              "columns": [
                { "type": "Column", "$data": "${days}", "width": "stretch", "spacing": "none", "items": [ { "type": "TextBlock", "text": "${name}", "size": "small", "weight": "${weight}", "isSubtle": "${subtle}", "horizontalAlignment": "center", "maxLines": 1 } ] }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$when": "${size == 'large' && hasProjects}",
          "spacing": "large",
          "items": [
            { "type": "TextBlock", "text": "Top projects today", "size": "small", "weight": "bolder" },
            {
              "type": "ColumnSet",
              "$data": "${projects}",
              "spacing": "small",
              "columns": [
                { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${name}", "size": "small", "isSubtle": true, "maxLines": 1 } ] },
                { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${amount}", "size": "small", "weight": "bolder" } ] }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "$when": "${size != 'small' && footerMode == 'today'}",
          "spacing": "${gap}",
          "selectAction": { "type": "Action.Execute", "verb": "refresh", "title": "Refresh" },
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center", "items": [ { "type": "TextBlock", "text": "${footer}", "size": "small", "isSubtle": true, "maxLines": 1 } ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "items": [ { "type": "Image", "url": "${syncIcon}", "width": "14px", "height": "14px", "altText": "Refresh" } ] }
          ]
        },
        {
          "type": "Container",
          "$when": "${size != 'small' && footerMode == 'setup'}",
          "spacing": "${gap}",
          "selectAction": { "type": "Action.Execute", "verb": "showLiveLimits", "title": "Add Dev Pane to Claude Code's status line to show percent used" },
          "items": [
            { "type": "TextBlock", "text": "Show % used from Claude Code →", "size": "small", "weight": "bolder", "color": "accent", "maxLines": 1 }
          ]
        },
        {
          "type": "TextBlock",
          "$when": "${size != 'small' && footerMode == 'message'}",
          "text": "${footerMessage}",
          "size": "small",
          "isSubtle": true,
          "wrap": true,
          "maxLines": 2,
          "spacing": "${gap}"
        }
      ]
    }
  ]
}
