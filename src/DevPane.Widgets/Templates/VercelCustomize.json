{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "minHeight": "6px",
      "items": []
    },
    { "type": "TextBlock", "text": "Show deployments from", "weight": "bolder", "wrap": true },
    { "type": "TextBlock", "$when": "${loading}", "text": "Loading your teams and projects…", "size": "small", "isSubtle": true, "wrap": true },
    {
      "type": "Input.ChoiceSet",
      "id": "scope",
      "style": "compact",
      "value": "${selected}",
      "choices": [
        { "title": "Everything this token can see", "value": "all" },
        { "$data": "${choices}", "title": "${title}", "value": "${value}" }
      ]
    },
    {
      "type": "Container",
      "$when": "${connected}",
      "spacing": "large",
      "items": [
        { "type": "TextBlock", "text": "Connected to Vercel with an access token", "size": "small", "isSubtle": true, "wrap": true },
        {
          "type": "ActionSet",
          "actions": [ { "type": "Action.Execute", "title": "Disconnect Vercel", "verb": "disconnect" } ]
        }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Save", "verb": "saveCustomization" },
    { "type": "Action.Execute", "title": "Cancel", "verb": "cancelCustomization" }
  ]
}
