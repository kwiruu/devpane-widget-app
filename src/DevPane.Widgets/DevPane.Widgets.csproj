<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: Windows starts the provider in the background, so it must not open a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>DevPane.Widgets</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Widgets Board only loads widget providers from packaged (MSIX) apps. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to the output folder too, so the build output can be registered as a loose package. -->
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Templates\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Images in Assets\Local replace the same-named images in Assets\Widgets, on this PC only. The folder is gitignored,
    for artwork that can't be committed or shipped, such as the Task Manager icon from tools\extract-taskmanager-icon.cs.
  -->
  <ItemGroup>
    <LocalAsset Include="Assets\Local\*.png" />
    <Content Remove="@(LocalAsset->'Assets\Widgets\%(Filename)%(Extension)')" />
    <Content Remove="@(LocalAsset)" />
    <Content Include="@(LocalAsset)" Link="Assets\Widgets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Microsoft.WindowsAppSDK metapackage pulls in WinUI, WebView2, Search and the Windows AI stack, whose
      DirectML and ONNX Runtime binaries are ~47 MB of the package for all three architectures at once. Dev Pane
      only calls Microsoft.Windows.Widgets, so it takes the Widgets package and the Runtime package (which
      declares the Windows App Runtime framework dependency) instead of the metapackage that bundles the rest.
      Add a package back here if a card starts using something else from the Windows App SDK.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevPane.Integrations\DevPane.Integrations.csproj" />
  </ItemGroup>

  <!-- The render-previews command and its made-up data are for tools\render-previews.ps1, not for the Store build. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Previews\**" />
  </ItemGroup>

  <!-- Enables Visual Studio's package deployment and the Package and Publish menu. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
